{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bash -lc 'bun run build && mkdir -p dist/vstarz && cp -R dist/. dist/vstarz/'",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/vstarz/", "permanent": false },
    { "source": "/vstarz", "destination": "/vstarz/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vstarz/:path*", "destination": "/vstarz/index.html" }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vstarz/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vstarz/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "env": {
    "VITE_APP_BASE": "/vstarz/",
    "VITE_CONVEX_URL": "https://combative-kookabura-535.convex.cloud"
  }
}
